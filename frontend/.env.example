# ─── Frontend environment template ───────────────────────────────────────────
# Copy to `frontend/.env` (gitignored) and fill in real values.

# Pinata JWT used to pin student evidence files to IPFS (Phase B).
# Create one at https://app.pinata.cloud → API Keys. Scope it to pinFileToIPFS only.
# NOTE: this key ships in the browser bundle — use a restricted key for the demo.
VITE_PINATA_JWT=

# Optional: a dedicated Pinata gateway, e.g. https://your-gateway.mypinata.cloud/ipfs/
# Falls back to the public gateway when unset.
VITE_PINATA_GATEWAY=
